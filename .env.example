# ── Environment variables for SENAMHI DataLake ──
# Copy this file to .env and adjust values for your deployment.

# Project
PROJECT_NAME="SENAMHI DataLake"
PROJECT_VERSION="2.0.0"

# Database
DATABASE_URL="sqlite+aiosqlite:///./data/senamhi.db"

# Security — CHANGE THESE IN PRODUCTION!
SECRET_KEY="generate-a-random-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL="INFO"

# SENAMHI scraper
SENAMHI_BASE_URL="https://www.senamhi.gob.pe/mapas/mapa-estaciones-2/map_red_graf.php"
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_WORKER_TIMEOUT_SECONDS=300
SCRAPER_POLL_INTERVAL=0.5
# Keep false on Windows: Chromium/zendriver is more reliable from the CLI queue worker.
EXECUTE_SCRAPER_IN_API=false

# File paths (relative to project root)
STATIONS_FILE="data/estaciones.json"
OUTPUT_DIR="output"
CSV_DIR="output/csv"
